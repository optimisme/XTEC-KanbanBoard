NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=kanban
DB_USER=kanban
DB_PASSWORD=

# OpenID Connect identity provider.
# OIDC_PROVIDER: "google" (Google Workspace) or "microsoft" (Microsoft Entra ID).
# Google issuer:    https://accounts.google.com
# Microsoft issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_PROVIDER=google
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The callback route is served on the path of this URL (it must start with /auth/).
OIDC_CALLBACK_URL=http://localhost:3000/auth/callback
# One or more institutional domains, comma separated (e.g. xtec.cat,iesesteveterradas.cat).
ALLOWED_EMAIL_DOMAIN=

# Email of the first administrator. This account is activated as admin on its
# first institutional login. Every other new account starts as "pending".
INITIAL_ADMIN_EMAIL=

# Optional administrator that signs in with a username and password instead
# of the identity provider. Leave both empty to disable it. In production the
# password must have at least 12 characters and must not contain the username.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Development-only login without an identity provider.
# The server refuses to start if this is "true" while NODE_ENV=production.
DEV_AUTH_ENABLED=false
