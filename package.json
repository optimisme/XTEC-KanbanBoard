{
  "name": "educational-kanban",
  "version": "1.0.0",
  "description": "Educational Kanban board for vocational training projects",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "create-admin": "node src/db/create-admin.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "marked": "^15.0.0",
    "mysql2": "^3.11.0",
    "openid-client": "^6.1.0",
    "sanitize-html": "^2.13.0",
    "ws": "^8.23.0"
  },
  "overrides": {
    "mysql2": "$mysql2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
